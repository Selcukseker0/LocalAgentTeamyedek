# ============================================================================
#  TEMİZ .env  —  bu dosyayı .env olarak kaydedin (üzerine yazın)
#
#  1) Dosya adını ".env" yapın:   Copy-Item .env.duzeltilmis .env -Force
#  2) LLM_API_KEY satırına YENİ Groq anahtarınızı yazın (aşağıdaki nota bakın)
#  3) npm.cmd run doctor      -> hepsi ✅ olmalı
#
#  Not: Sohbete yapıştırdığınız iki anahtar artık açıkta. İkisini de iptal edip
#  yenileyin:  https://console.groq.com/keys  ve  https://aistudio.google.com/apikey
#
#  Kurallar (bu dosyanın neden böyle olduğu):
#   - Her anahtar SADECE BİR KEZ yazılır. Eskiden LLM_PROVIDER iki kez vardı
#     (gemini, sonra groq) ve son satır sessizce kazanıyordu.
#   - Sayısal değerlerde harf olmaz. GROUNDING_MIN_NUMBER=10cls yüzünden
#     uydurma-sayı kontrolü sessizce tamamen kapanmıştı.
#   - Değerin sonunda boşluk/nokta olmaz ("gsk_...X." gibi). Kopyala-yapıştır
#     kalıntısı anahtarı geçersiz yapar.
#   - Model adı uydurulmaz: GEMINI_MODEL boş bırakılır, kod kendi çözer.
# ============================================================================

TZ=Europe/Istanbul

# --- Yerel model (yedek) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Senaryoyu kim yazsın ---
# Gemini ücretsiz kotanız doldu (429). Groq ücretsiz katmanı hızlı ve geniş:
# saniyeler içinde cevap verir. Anahtar: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_URL=
LLM_API_TIMEOUT_MS=60000

# Gemini'yi sonra tekrar denemek isterseniz yeni anahtarı buraya yazıp
# LLM_PROVIDER=gemini yapın. Model adı YAZMAYIN, boş kalsın.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=45000

# Anthropic ücretli, kullanmıyoruz.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 429/ağ hatasında kaç kez denensin
LLM_RETRIES=2
# 1 = birincil sağlayıcı çökerse Ollama'ya düşme, hemen hata ver.
# Yavaş yerel modelle 10 dakika beklemektense sorunu anında görmek iyidir.
LLM_NO_FALLBACK=1
LLM_BREAKER_FAILURES=2

OLLAMA_NUM_PREDICT=900
OLLAMA_NUM_GPU=
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=300000
OLLAMA_SLOW_WARN_MS=90000

PREPARE_CRON=30 19 * * *
TELEGRAM_HOUR=19
TELEGRAM_MINUTE=55
PUBLISH_HOUR=20
PUBLISH_MINUTE=0

# --- Sahne görselleri: ücretsiz, anahtarsız ---
IMAGE_PROVIDER=pollinations
IMAGE_MODEL=flux
IMAGE_SIZE=1024x1536
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_STYLE_PROMPT=
IMAGE_MAX_ATTEMPTS=3
IMAGE_VISION_PASS=7
# Pollinations anonim katmanı oran sınırlı (~5-15 sn'de 1 istek).
# 8000'in altına indirmeyin; 429'da kod bekleyip kendisi tekrar dener.
IMAGE_REQUEST_DELAY_MS=8000
IMAGE_429_RETRIES=4

IMAGE_SHARPEN=1
IMAGE_LINE_BOOST=1
WHITEBOARD_COVER=1

# --- Görsel doğrulama (vision) ---
# Gemini kotası dolu olduğu için KAPALI. Üretim durmaz, sadece "görsel cümleyi
# anlatıyor mu" puanlaması atlanır. Gemini anahtarını yenileyince 1 yapın.
VISION_CHECK=0
VISION_PROVIDER=
VISION_MODEL=
VISION_API_URL=
VISION_API_KEY=

# --- Araştırma ---
RESEARCH_ENABLED=1
RESEARCH_MIN_MATCH=0.34
RESEARCH_FACT_OVERLAP=0.45
# Bu sayının altındaki sayılar (0-99) kaynak denetiminden muaf.
# TEK satır, düz sayı. (Eskiden "10cls" yazıyordu + ikinci bir "=1" satırı vardı.)
GROUNDING_MIN_NUMBER=10

SCRIPT_CRITIQUE=1
SCRIPT_BUDGET_SEC=600
# auto = ollama seçiliyse tek geçiş. Groq hızlı olduğu için burada da tek geçiş
# yeterli; tek çağrıda bütün senaryoyu yazar.
SCRIPT_SINGLE_PASS=1
SCRIPT_FALLBACK_SCENES=6
SCRIPT_FALLBACK_WORDS=55
SCRIPT_MIN_SCORE=7

# --- Beyaz tahta video ---
PYTHON_BIN=python
FFMPEG_PATH=
WHITEBOARD_FONT=
FRAME_FORMAT=jpg
SUBTITLE_KARAOKE=1
RENDER_WORKERS=1

MUSIC_PATH=
MUSIC_VOLUME=0.16
MUSIC_FADE_OUT=0.8

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_PRIVACY_STATUS=unlisted

TTS_VOICE=tr-TR-AhmetNeural
TTS_RATE=+20%
TTS_WORDS_PER_SECOND=2.9

TZ=Europe/Istanbul
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Senaryo/konu üretimini hangi model yapsın: ollama | gemini | anthropic
# gemini/anthropic seçilirse API anahtarı gerekir; hata olursa Ollama'ya düşer.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Uzun senaryolar için üretim sınırı (token). 512 çok küçük kalıyordu.
OLLAMA_NUM_PREDICT=900
# Boş bırakılırsa Ollama GPU/CPU kararını kendi verir.
# 0 yazarsanız CPU'ya kilitlenir (yavaş).
OLLAMA_NUM_GPU=
# Model bellekte ne kadar kalsın (her istekte yeniden yüklenmesin).
OLLAMA_KEEP_ALIVE=30m

PREPARE_CRON=30 19 * * *
TELEGRAM_HOUR=19
TELEGRAM_MINUTE=55
PUBLISH_HOUR=20
PUBLISH_MINUTE=0

PEXELS_API_KEY=

# --- Sahne görselleri (opsiyonel ama önerilir) ---
# Her cümle için ayrı illüstrasyon üretir. Boş bırakılırsa yerleşik çizim
# kütüphanesi (57 nesne, kompozisyon) kullanılır.
# openai  -> gpt-image-1 (OPENAI_API_KEY gerekir)
# gemini  -> imagen-3.0-generate-002 (GEMINI_API_KEY gerekir)
# custom  -> kendi ucuz API'niz (IMAGE_API_URL + IMAGE_API_KEY)
IMAGE_PROVIDER=
# openai: gpt-image-1 | gemini: imagen-3.0-generate-002
IMAGE_MODEL=
# openai: 1024x1536 | gemini: 3:4
IMAGE_SIZE=
IMAGE_API_KEY=
IMAGE_API_URL=
# Stil prompt'u (varsayılan: siyah marker çizgi sanatı, beyaz zemin, sade dolgu)
IMAGE_STYLE_PROMPT=
# Sahne başına en fazla deneme (1 üretim + 2 onarım). Vision puanı düşükse yeniden üretir.
IMAGE_MAX_ATTEMPTS=3
# Vision doğrulamasında bu puan ve üstü kabul edilir (1-10).
IMAGE_VISION_PASS=7

# --- Görsel doğrulama (vision) ---
# Üretilen görsel cümleyi anlatıyor mu? Puan < IMAGE_VISION_PASS ise prompt düzeltilip
# yeniden üretilir. Anahtar yoksa atlanır; üretim durmaz.
# gemini | openai | custom   (custom: yerel vision sunucusu, POST {image, question})
VISION_CHECK=1
VISION_PROVIDER=
VISION_MODEL=
VISION_API_URL=
VISION_API_KEY=

# --- Araştırma (kaynak metin) ---
# Wikipedia (TR + EN) üzerinden doğrulanmış olgu toplar. 0 yazarsan atlanır.
RESEARCH_ENABLED=1
# Senaryo editör geçişi: soyut kelime / tekrar / kaynak uyumu / hook kontrolü.
SCRIPT_CRITIQUE=1
# Editör puanı bunun altındaysa senaryo bir kez daha yazılır (1-10).
SCRIPT_MIN_SCORE=7

# Beyaz tahta (keçeli kalem) video ayarları
PYTHON_BIN=python
# ffmpeg PATH'te yoksa tam yolu yazın (yoksa `pip install imageio-ffmpeg`)
FFMPEG_PATH=
# Türkçe karakter destekli kalın font (boşsa otomatik aranır)
WHITEBOARD_FONT=
# Kare biçimi: jpg (hızlı, varsayılan) veya png (kayıpsız, ~4 kat yavaş)
FRAME_FORMAT=jpg

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_PRIVACY_STATUS=unlisted

TTS_VOICE=tr-TR-AhmetNeural
# Sesin okuma hızı (kelime/saniye). 30-45 sn hedefi buna göre hesaplanır.
TTS_WORDS_PER_SECOND=2.9